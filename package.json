{
  "name": "bb-plugin-pstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The pstack engineering skill library, delivered as a BB plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariusflorescu/bb-plugin-pstack.git"
  },
  "homepage": "https://github.com/mariusflorescu/bb-plugin-pstack#readme",
  "bugs": {
    "url": "https://github.com/mariusflorescu/bb-plugin-pstack/issues"
  },
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.84"
  },
  "bb": {
    "name": "pstack",
    "description": "Playbooks, reviewers, and principles for rigorous agent-assisted development, adapted from cursor/plugins pstack.",
    "branding": {
      "icon": "Layers"
    },
    "server": "./server.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.json",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2",
    "yaml": "2.9.1"
  },
  "files": [
    "server.ts",
    "src",
    "components",
    "lib",
    "skills",
    "docs",
    "assets",
    "README.md",
    "UPSTREAM-README.md",
    "PLUGIN_OVERVIEW.md",
    "BB-NATIVE.md",
    "MANIFEST.md",
    "UPSTREAM",
    "LICENSE",
    "!**/*.test.*"
  ]
}
